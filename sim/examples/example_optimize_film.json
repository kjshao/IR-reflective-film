{
  "comment": "3-band joint R optimisation on a constant-n,k text stack (adam|lm|de|dual_annealing).",
  "n_bands": 3,
  "method": "adam",
  "bands": [
    {
      "wavelength_nm": [420, 700],
      "objective": "minimize",
      "weight": 2.0,
      "ripple_weight": 0.5
    },
    {
      "wavelength_nm": [800, 1200],
      "objective": "maximize",
      "weight": 1.5,
      "ripple_weight": 0.3
    },
    {
      "wavelength_nm": [1400, 1800],
      "objective": "maximize",
      "weight": 1.0,
      "ripple_weight": 0.2
    }
  ],
  "wavelength_step_nm": 15,
  "max_iter": 40,
  "thickness_weight": 0.0,
  "fd_step_nm": 0.5,
  "min_thickness_nm": 8,
  "nk_source": "library",
  "nk_ref_wavelength_nm": 550,
  "init": {
    "mode": "random_qw",
    "seed": 0,
    "jitter": 0.35,
    "qw_fraction": 0.25
  },
  "adam_lr_nm": 2.0,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_eps": 1e-8,
  "adam_max_step_nm": 10.0,
  "incident_angle_deg": 0,
  "polarization": "unpolarized",
  "plot_wavelength_nm": [400, 1800],
  "plot_step_nm": 5,
  "output_dir": "../out/optimize_example",
  "mini_batch": false,
  "_mini_batch_example": {
    "comment": "Set mini_batch to this object (or true + top-level keys) to enable wavelength mini-batches.",
    "batch_size": 8,
    "n_batches": 10,
    "n_epochs": 40,
    "shuffle_seed": 0
  }
}
